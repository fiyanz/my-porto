# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=portfolio

# Database URL:
# Local Docker: postgresql+asyncpg://postgres:postgres@db:5432/portfolio
# Supabase Production: postgresql+asyncpg://[POSTGRES_USER]:[POSTGRES_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/[POSTGRES_DB]
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/portfolio

# API Security
SECRET_KEY=yoursecretkeyhere_changethisinproduction
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 hours

# Frontend
# Local: http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Supabase Configuration
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_JWKS_URL=https://your-supabase-project.supabase.co/auth/v1/.well-known/jwks.json

# External Integrations (Optional)
GITHUB_TOKEN=
WAKATIME_API_KEY=
GOOGLE_DRIVE_FOLDER_URL=
GOOGLE_DRIVE_API_KEY=


